# ─────────────────────────────────────────────────────────────────────────────
# Interview AI — Environment Variables
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to `.env.local` (apps/web) and `.env` (packages/database),
# then fill in the values below.
#
#   cp .env.example apps/web/.env.local
#   cp .env.example packages/database/.env
# ─────────────────────────────────────────────────────────────────────────────

# ── PostgreSQL ────────────────────────────────────────────────────────────────
# Connection string for the PostgreSQL database.
# The default below matches the docker-compose.yml dev setup.
DATABASE_URL="postgresql://postgres:password@localhost:5432/interview_ai"

# ── Authentication (Auth.js v5) ──────────────────────────────────────────────
# A random secret used to sign/encrypt JWT tokens.
# Generate one with: openssl rand -base64 32
AUTH_SECRET=""

# GitHub OAuth — Create an OAuth App at https://github.com/settings/developers
# Set the callback URL to: http://localhost:3000/api/auth/callback/github
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""

# ── Google Gemini AI ─────────────────────────────────────────────────────────
# API key for the Google Gemini 1.5 Flash model.
# Get one at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=""

# ── Upstash Redis (Rate Limiting) ────────────────────────────────────────────
# REST credentials for Upstash Redis, used for edge-compatible rate limiting.
# Create a free database at: https://console.upstash.com
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# ── Sentry (Error Monitoring) — Optional ─────────────────────────────────────
# Sentry DSN for client-side, server-side, and edge error tracking.
# Leave empty to disable Sentry. Get a DSN at: https://sentry.io
NEXT_PUBLIC_SENTRY_DSN=""

# ── Logging — Optional ──────────────────────────────────────────────────────
# Controls the verbosity of the structured logger.
# Values: "fatal" | "error" | "warn" | "info" | "debug" | "trace"
# Defaults to "info" if not set.
LOG_LEVEL="info"

# ── Server — Optional ───────────────────────────────────────────────────────
# Port and hostname for the production standalone server.
# These are pre-configured in the Dockerfile; override only if needed.
# PORT=3000
# HOSTNAME="0.0.0.0"
